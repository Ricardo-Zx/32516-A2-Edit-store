# ── Copy this file to ".env" — for the Docker / local-MongoDB path you
# ── do NOT need to change anything; the defaults below just work.

# Default: works as-is with `docker compose up -d` OR a local mongod.
MONGODB_URL=mongodb://localhost:27017
# To use MongoDB Atlas instead, comment the line above and use this:
# MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?appName=Cluster0

MONGODB_DB=hm_store

# Any non-empty random string works — this default is fine for local/demo use.
JWT_SECRET=dev-demo-secret-0a1b2c3d4e5f67890a1b2c3d4e5f6789
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
